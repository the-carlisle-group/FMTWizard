 Response←{
     ⎕←'You clicked the '⍵.Component.Label'button'
     d←⍵.Document
     j←''
     R←d A.GetComponentValues 0
     x←12345

     S←()⎕VSET R
     j←(⍕S.Columnwidth),j

     j←((S.Decimals≠0)⊃(('I',j)('F',j,'.',⍕S.Decimals)))

     j←'K',⍕S.Scale,j

     j←'P','<',S.PositivePrefix,'>',j
     j←'M','<',S.NegativePrefix,'>',j
     j←'Q','<',S.PositiveSuffix,'>',j
     j←'N','<',S.NegativeSuffix,'>',j
     j←'R','<',S.BackgroundText,'>',j













     j←(S.CommaBox/'C'),j
     j←(S.LeftJustifyBox/'L'),j
     j←(S.BlankZeroBox/'B'),j
     j←(S.ZeroFill/'Z'),j


     ⎕←j ⎕FMT x


     0
 }
