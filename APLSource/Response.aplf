 Response←{
     ⎕←'You clicked the '⍵.Component.Label'button'
     d←⍵.Document
     j←''
     R←d A.GetComponentValues 0


     S←()⎕VSET R

     x←S.UserInput


     j←(⍕S.Columnwidth),j

     j←((S.Decimals≠0)⊃(('I',j)('F',j,'.',⍕S.Decimals)))

     j←'K',⍕S.Scale,j

     j←((S.PositivePrefix≢'')/('P','<',S.PositivePrefix,'>')),j
     j←((S.NegativePrefix≢'')/'M','<',S.NegativePrefix,'>'),j
     j←((S.PositiveSuffix≢'')/'Q','<',S.PositiveSuffix,'>'),j
     j←((S.NegativeSuffix≢'')/'N','<',S.NegativeSuffix,'>'),j
     j←((S.BackgroundText≢'')/'R','<',S.BackgroundText,'>'),j





     m←((S.Decimals≠0)∧(S.DecimalPoint≢'.'))/'.',⊃S.DecimalPoint
     n←(S.TriadSeparator≢',')/',',⊃S.TriadSeparator
     o←(S.ZeroFillChange≢'0')/'0',⊃S.ZeroFillChange
     p←(S.OverflowFill≢'*')/'*',⊃S.OverflowFill
     q←(S.PrecisionLoss≢'_')/'_',⊃S.PrecisionLoss
     y←m,n,o,p,q
     j←((y≢'')/'S<',y,'>'),j




     j←(S.CommaBox/'C'),j
     j←(S.LeftJustifyBox/'L'),j
     j←(S.BlankZeroBox/'B'),j
     j←(S.ZeroFill/'Z'),j


     z←d A.GetElementById'LeftArgument'

     _←z A.SetInnerHTML,j

     ⎕←j ⎕FMT x
     k←d A.GetElementById'Result'
     _←k A.SetInnerHTML,j ⎕FMT x


     0
 }
