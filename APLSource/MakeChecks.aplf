 MakeChecks←{

     gg←'UserInput'A.NumberInput.New'Input your Number'
     gg.OnChange←A.FQP'Response'



     xx←A.New'p'(⍕0)

     xx.id←'Result'
     yy←A.New'p'
     yy.id←'LeftArgument'

     c←'LeftJustifyBox'A.CheckBox.New'Left justify'
     c.OnChange←A.FQP'Response'
     e←'CommaBox'A.CheckBox.New'Commas'
     e.OnChange←A.FQP'Response'
     f←'BlankZeroBox'A.CheckBox.New'Blanks as Zeros'
     f.OnChange←A.FQP'Response'
     z←'ZeroFill'A.CheckBox.New'Zero fill'
     z.OnChange←A.FQP'Response'
     b←A.FieldSet.New('Border' 1)('Content'(c e f z))('Format' 'inline')('Legend' 'Options')

     g←'Decimals'A.NumberInput.New(⊂'Label' 'Decimal places')
     g.OnChange←A.FQP'Response'
     h←'Columnwidth'A.NumberInput.New('Label' 'Column width')('Value' 20)
     h.OnChange←A.FQP'Response'
     l←'Scale'A.NumberInput.New(⊂'Label' 'Scale (move decimal)')
     l.OnChange←A.FQP'Response'
     i←A.FieldSet.New('Border' 1)('Content'(g h l))('Format' 'inline')('Legend' 'Basic format instructions')


     m←'PositivePrefix'A.TextInput.New(⊂'Label' 'Positive prefix')
     m.OnChange←A.FQP'Response'
     n←'PositiveSuffix'A.TextInput.New(⊂'Label' 'Positive suffix')
     n.OnChange←A.FQP'Response'
     o←'NegativePrefix'A.TextInput.New(⊂'Label' 'Negative prefix')
     o.OnChange←A.FQP'Response'
     p←'NegativeSuffix'A.TextInput.New(⊂'Label' 'Negative suffix')
     p.OnChange←A.FQP'Response'
     q←'BackgroundText'A.TextInput.New(⊂'Label' 'Background text')
     q.OnChange←A.FQP'Response'
     r←A.FieldSet.New('Border' 1)('Content'(m n o p q))('Format' 'inline')('Legend' 'Decorations')

     v←'DecimalPoint'A.TextInput.New('Label' 'Decimal point')('Value' '.')
     v.OnChange←A.FQP'Response'
     w←'TriadSeparator'A.TextInput.New('Label' 'Triad separator')('Value' ',')
     w.OnChange←A.FQP'Response'
     y←'ZeroFillChange'A.TextInput.New('Label' 'Zero fill')('Value' '0')
     y.OnChange←A.FQP'Response'
     aa←'OverflowFill'A.TextInput.New('Label' 'Overflow fill')('Value' '*')
     aa.OnChange←A.FQP'Response'
     bb←'PrecisionLoss'A.TextInput.New('Label' 'Precision loss')('Value' '_')
     bb.OnChange←A.FQP'Response'
     cc←A.FieldSet.New('Border' 1)('Content'(v w y aa bb))('Format' 'inline')('Legend' 'Default characters')



     u←A.New'div'('Content'(b i r cc))('id' 'myset')








     d←A.NewDocument gg,xx,yy,u
     d.AppStyle←CSS 0
     d

 }
